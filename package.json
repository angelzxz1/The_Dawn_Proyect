{
  "name": "the-dawn-project",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:e2e": "playwright test",
    "test:engine": "cargo test -p dawn-engine",
    "desktop": "npx --yes @tauri-apps/cli@2 dev",
    "desktop:build": "npx --yes @tauri-apps/cli@2 build",
    "prebuild": "node scripts/build-sw.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tonejs/midi": "^2.0.28",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "standardized-audio-context": "^25.3.77",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "vitest-browser-react": "1.0.1"
  },
