# Cloudflare Pages (and Netlify) read this file from the site's root.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), midi=(self), camera=(), geolocation=()

# Hashed build files never change, so browsers keep them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The amp engine isn't hashed: cache it for a day, then check for a new one.
/nam/*
  Cache-Control: public, max-age=86400, must-revalidate

/nam/*.wasm
  Content-Type: application/wasm

# The service worker must always be checked for a new version.
/sw.js
  Cache-Control: no-cache
  Content-Type: text/javascript

/manifest.webmanifest
  Content-Type: application/manifest+json
